FROM eclipse-temurin:25-jdk

WORKDIR /app

RUN apt-get update && apt-get install -y jq netcat-traditional curl && apt-get clean

# Download Velocity proxy JAR (4.2.0 is the first release that speaks Minecraft 26.3; the Hangzhou host runs the same build)
RUN curl -fSL -o velocity.jar "https://fill-data.papermc.io/v1/objects/0844bcabdcdb4f5b875906fd4c3365bc1bb76918e42bc595ed88ad195258dd75/velocity-4.3.1-45.jar" \
    && echo "0844bcabdcdb4f5b875906fd4c3365bc1bb76918e42bc595ed88ad195258dd75  velocity.jar" | sha256sum -c -

COPY ./DockerFiles/jars /app/prebuilt_jars

ARG JAR_BASE_URL=

RUN set -eu; \
    mkdir -p plugins; \
    if [ -f /app/prebuilt_jars/SkyBlockProxy.jar ]; then \
        echo "Using locally built SkyBlockProxy.jar"; \
        cp /app/prebuilt_jars/SkyBlockProxy.jar plugins/SkyBlockProxy.jar; \
    elif [ -n "$JAR_BASE_URL" ]; then \
        echo "Downloading SkyBlockProxy.jar"; \
        curl -fSL -o plugins/SkyBlockProxy.jar "${JAR_BASE_URL}/SkyBlockProxy.jar"; \
    else \
        echo "SkyBlockProxy.jar is missing from DockerFiles/jars; build it first (see README.md) or pass --build-arg JAR_BASE_URL" >&2; \
        exit 1; \
    fi; \
    rm -rf /app/prebuilt_jars

# Copy configuration data
COPY ./configuration /app/configuration_files

# Replace generated velocity.toml with our own
RUN rm -f velocity.toml && \
    cp configuration_files/velocity.toml velocity.toml

# Set up config.yml template
RUN mkdir -p configuration && \
    cp configuration_files/config.docker.yml ./configuration/config.yml

EXPOSE 25565

CMD ["sh", "-c", "[ -n \"$FORWARDING_SECRET\" ] || { echo 'FORWARDING_SECRET is required' >&2; exit 1; }; printf '%s' \"$FORWARDING_SECRET\" > /app/forwarding.secret; sed -i \"s/velocity-secret: .*/velocity-secret: '$FORWARDING_SECRET'/\" /app/configuration/config.yml; java -jar velocity.jar"]
